# Copy to .env (git-ignored), fill in. Placeholders only. Never commit real values.

# RunPod API key: used by all scripts. Reading works with a read-only key;
# create-pod.sh, pod-start.sh, pod-stop.sh and pod-terminate.sh need write access to Pods (else HTTP 403).
RUNPOD_API_KEY=

# Pod ID printed by create-pod.sh (one Pod). Most scripts take the single ACTIVE pool Pod first
# and use this only as a fallback.
RUNPOD_POD_ID=

# The ID of your existing Network Volume: REQUIRED to create Pods with STORAGE=network. A resource ID, not a secret.
NETWORK_VOLUME_ID=

# Where the model and the caches live (see docs/guide.md "Global Volume"):
#   network (default): Network Volume on /workspace holds model and caches; the Pod is bound to its datacenter
#   local: no volume. The Pod downloads the model from Hugging Face at every start onto its container disk
#           (CONTAINER_DISK_GB defaults to 200 then; needs the HF_TOKEN RunPod Secret and an image built from
#           image/ with PREFETCH_REPO support, newer than :3). MODEL: a Hugging Face id (downloaded to /models/<name>)
#           or an absolute directory (then MODEL_REPO names the repo). MODEL_REVISION pins the commit.
#   global: a Global Volume (beta) on /workspace holds only the model, caches stay on the container disk;
#           needs GLOBAL_VOLUME_ID and MODEL=<directory on the volume>; the Pod is created through GraphQL
#           (REST v2 cannot attach it); not run yet
# STORAGE=network
# MODEL_REPO=                   # with STORAGE=local and MODEL=<directory>: default starkweatherdigital/qwen3.8-flash-next-nvfp4
# MODEL_REVISION=               # with STORAGE=local: default 1b304e5f99de0faaf43c3a959f2b4000294bf65c
# GLOBAL_VOLUME_ID=             # make volume ARGS='--global --yes' prints it
# MODEL=/workspace/models/qwen3.8-flash-next-nvfp4   # with STORAGE=global
# make fill-volume (fills the Global Volume with the model): optional FILL_MODEL_REPO, FILL_REVISION, FILL_TARGET,
# FILL_GPU_IDS (comma separated), FILL_DISK_GB (160), FILL_IMAGE, FILL_TIMEOUT (7200); see scripts/fill-volume.sh
# HF_HOME_DIR=                  # default /workspace/huggingface (network), /root/.cache/huggingface (global)
# VLLM_CACHE_DIR=               # default /workspace/vllm-cache (network), /root/.cache/vllm (global)

# REQUIRED to create Pods: the patched x86_64 vLLM image you built from image/ and pushed to a
# registry, ideally pinned by digest. The arm64/sm121 (DGX Spark) image cannot run on a B200.
# Published (public) build :4, linux/amd64: :3 plus the download at start (PREFETCH_REPO, needed by STORAGE=local).
# :3 (digest 26650509...) was verified on a Pod on 2026-10-04 and is enough for STORAGE=network and STORAGE=global.
REMOTE_IMAGE=docker.io/pt9912/vllm-qwen38-b200@sha256:f4ffbb29303c20fa0a473a89fb017a60f872b115a6a52ae99533111748210774

# Same value as the RunPod Secret VLLM_API_KEY (needed by wait-for-ready.sh, check-endpoint.sh and Claude Code)
VLLM_API_KEY=

# Optional: override the REST API base URL (default https://api.runpod.io/v2)
# RUNPOD_BASE_URL=

# Optional: client side URL (Claude Code, wait-for-ready.sh) if no pool Pod is active
# QWEN_URL=https://POD_ID-8000.proxy.runpod.net

# Optional: the Pod pool = all Pods whose name starts with POOL_PREFIX (read live, no IDs stored)
# POOL_PREFIX=qwen3.8-flash-next
# POOL_MAX=6

# Optional serving profile (see README). Defaults shown.
# GPU_IDS="NVIDIA H200,NVIDIA H200 NVL,NVIDIA B200"   # fallback list in order of preference: the first card with capacity wins (see docs/guide.md)
# GPU_ID=NVIDIA B200            # run `make gpu ARGS='B200'` (or the card's name) and use the exact id RunPod reports
# GPU_COUNT=1                   # N>1: N GPUs of one machine, vLLM tensor parallelism N (not validated)
#   Example, 2 cards: GPU_ID=<exact id from `make gpu ARGS='"RTX PRO 6000"'`>  GPU_COUNT=2
# VLLM_EXTRA_ARGS=              # extra `vllm serve` arguments, appended last
# DATACENTER=                   # default: the datacenter of the Network Volume
# CONTAINER_DISK_GB=50
# VOLUME_SIZE_GB=150            # make volume
# VOLUME_NAME=qwen3.8-flash-next
# MODEL=starkweatherdigital/qwen3.8-flash-next-nvfp4
# MAX_MODEL_LEN=131072
# MAX_NUM_SEQS=16               # e.g. MAX_MODEL_LEN=262144 and MAX_NUM_SEQS=6 on an H200 with PLE_MMAP=1
# YARN_FACTOR=                  # static YaRN beyond 262144: 4.0 (up to 1M) or 2.0 (524288), with MAX_MODEL_LEN above 262144; untested
# GPU_MEMORY_UTILIZATION=0.90
# PLE_MMAP=0                    # 1 needs MODEL=<local dir on the volume>; not validated on B200
