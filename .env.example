# Copy to .env (git-ignored), fill in. Placeholders only. Never commit real values.

# RunPod API key: used by all scripts. Reading works with a read-only key;
# create-pod.sh, pod-start.sh, pod-stop.sh and pod-terminate.sh need write access to Pods (else HTTP 403).
RUNPOD_API_KEY=

# Pod ID printed by create-pod.sh (one Pod). Most scripts take the single ACTIVE pool Pod first
# and use this only as a fallback.
RUNPOD_POD_ID=

# The ID of your existing Network Volume: REQUIRED to create Pods. A resource ID, not a secret.
NETWORK_VOLUME_ID=

# REQUIRED to create Pods: the patched x86_64 vLLM image you built from image/ and pushed to a
# registry, ideally pinned by digest. The arm64/sm121 (DGX Spark) image cannot run on a B200.
# Published (public) build :2, linux/amd64, patches 20/30/35/40/41 applied, TP and VLLM_EXTRA_ARGS
# support; never run on a GPU yet:
REMOTE_IMAGE=docker.io/pt9912/vllm-qwen38-b200@sha256:4e892eef3984225001df1f57a9e7080fecd3b870469c309d9b307f3772545f76

# Same value as the RunPod Secret VLLM_API_KEY (needed by wait-for-ready.sh, check-endpoint.sh and Claude Code)
VLLM_API_KEY=

# Optional: override the REST API base URL (default https://api.runpod.io/v2)
# RUNPOD_BASE_URL=

# Optional: client side URL (Claude Code, wait-for-ready.sh) if no pool Pod is active
# QWEN_URL=https://POD_ID-8000.proxy.runpod.net

# Optional: the Pod pool = all Pods whose name starts with POOL_PREFIX (read live, no IDs stored)
# POOL_PREFIX=qwen3.8-flash-next
# POOL_MAX=6

# Optional serving profile (see README). Defaults shown.
# GPU_ID=NVIDIA B200            # run `make gpu ARGS='B200'` (or the card's name) and use the exact id RunPod reports
# GPU_COUNT=1                   # N>1: N GPUs of one machine, vLLM tensor parallelism N (not validated)
#   Example, 2 cards: GPU_ID=<exact id from `make gpu ARGS='RTX PRO 6000'`>  GPU_COUNT=2
# VLLM_EXTRA_ARGS=              # extra `vllm serve` arguments, appended last
# DATACENTER=                   # default: the datacenter of the Network Volume
# CONTAINER_DISK_GB=50
# VOLUME_SIZE_GB=150            # make volume
# VOLUME_NAME=qwen3.8-flash-next
# MODEL=starkweatherdigital/qwen3.8-flash-next-nvfp4
# MAX_MODEL_LEN=131072
# GPU_MEMORY_UTILIZATION=0.90
# PLE_MMAP=0                    # 1 needs MODEL=<local dir on the volume>; not validated on B200
